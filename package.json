{
  "name": "@jose.donas/decorators",
  "version": "0.1.0",
  "description": "A TypeScript library providing reusable decorators for telemetry, caching, workers, feature flags, dependency injection, and more.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test:watch": "vitest",
    "test": "vitest run --coverage",
    "build": "tsc --build",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "lint": "eslint",
    "execute": "tsx"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "keywords": [
    "typescript",
    "decorators",
    "functional"
  ],
  "author": "José Antonio González Doñas <jose.gonzalez.donas@gmail.com>",
  "license": "ISC",
  "packageManager": "pnpm@10.17.1",
  "devDependencies": {
    "@commitlint/config-conventional": "20.0.0",
    "@eslint/css": "0.13.0",
    "@eslint/js": "9.37.0",
    "@eslint/json": "0.13.0",
    "@eslint/markdown": "7.4.0",
    "@types/node": "24.7.2",
    "@typescript-eslint/eslint-plugin": "8.46.0",
    "@typescript-eslint/parser": "8.46.0",
    "@vitest/coverage-v8": "3.2.4",
    "commitlint": "20.1.0",
    "eslint": "9.37.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "husky": "9.1.4",
    "jiti": "2.6.0",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4"
  }
}
